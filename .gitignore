# Secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
*.kdbx
secrets*.json
credentials*.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/

# Local databases
*.db
*.sqlite
*.sqlite3
*.duckdb

# Generated runtime data — ignore the whole tree; only public placeholders
# and empty directory markers are tracked. This is safer than enumerating
# individual filenames, which silently leaks anything not on the list.
data/**
!data/.gitkeep
!data/chains/
!data/chains/.gitkeep
!data/quotes/
!data/quotes/.gitkeep

# Logs
decision-logs/
*.log

# IDEs
.vscode/
.idea/
